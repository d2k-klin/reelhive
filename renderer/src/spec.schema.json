        "image_approved": {
          "default": false,
          "title": "Image Approved",
          "type": "boolean"
        },
        "visual_request": {
          "$ref": "#/$defs/VisualRequest",
          "default": {
            "kind": "none",
            "image": null,
            "clip": null,
            "route": null,
            "region": null,
            "prompt": null
          }
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualAsset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Narration WAV, relative to the run folder",
          "title": "Audio"
        },
        "hold": {
          "default": 0.0,
          "description": "Seconds the settled frame stays after the narration, so it can be read",
          "maximum": 3.0,
          "minimum": 0,
          "title": "Hold",
          "type": "number"
        },
        "words": {
          "description": "The narration's words as spoken; set by timing",
          "items": {
            "$ref": "#/$defs/Word"
          },
          "title": "Words",
          "type": "array"
        },
        "start": {
          "default": 0.0,
          "title": "Start",
