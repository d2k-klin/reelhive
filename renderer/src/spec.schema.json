            "type": "integer"
          },
          "title": "Covers",
          "type": "array"
        },
        "duration_override": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Override"
        },
        "voice_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/Voice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
