          "default": false,
          "title": "Image Approved",
          "type": "boolean"
        },
        "visual_request": {
          "$ref": "#/$defs/VisualRequest",
          "default": {
            "kind": "none",
            "image": null,
            "route": null,
            "prompt": null
          }
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualAsset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Narration WAV, relative to the run folder",
          "title": "Audio"
        },
        "start": {
          "default": 0.0,
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "default": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "template": {
          "const": "bullets",
          "default": "bullets",
          "title": "Template",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/BulletsText"
        }
      },
      "required": [
        "index",
        "narration",
        "text"
      ],
      "title": "BulletsScene",
      "type": "object"
    },
    "BulletsText": {
      "properties": {
        "headline": {
          "maxLength": 48,
          "title": "Headline",
          "type": "string"
